{
  "name": "salvage-northgate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify:logic": "esbuild scripts/verify.ts --bundle --platform=node --format=esm --jsx=automatic --log-level=error --outfile=.tmp/verify.mjs && node .tmp/verify.mjs",
    "verify:render": "esbuild scripts/ssr.tsx --bundle --platform=node --format=cjs --jsx=automatic --loader:.css=empty --log-level=error --outfile=.tmp/ssr.cjs && node .tmp/ssr.cjs"
  },
  "dependencies": {
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.21.5",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
